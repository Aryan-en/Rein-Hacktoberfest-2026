# Copy to .env (gitignored). Never commit real keys.

# --- AI provider -------------------------------------------------------------------------
# auto  = use Gemini if GEMINI_API_KEY is real, else DigitalOcean if DO_GENAI_API_KEY is real, else rules-only
# gemini | digitalocean = force one provider
AI_PROVIDER=auto

# Google Gemini API (serves the open-weight Gemma 4 models). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it
# Screenshot mode: Gemma 4 is multimodal but image input on the Gemini API is unverified. Empty = disabled.
GEMINI_VISION_MODEL=gemma-4-31b-it

# DigitalOcean GenAI (optional, paid). Placeholder/dummy values are ignored.
DO_GENAI_API_KEY=
DO_GENAI_BASE_URL=https://inference.do-ai.run/v1

# Model IDs must match GET /v1/models for your account (run: npm run verify-model).
TRUSTLENS_PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct
TRUSTLENS_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
# Optional vision-capable open-weight model. Leave empty to disable screenshot mode (503 image_analysis_unavailable).
TRUSTLENS_VISION_MODEL=
TRUSTLENS_VISION_FALLBACK_MODEL=
TRUSTLENS_JSON_MODE=true

TRUSTLENS_MODEL_TIMEOUT_MS=25000
TRUSTLENS_RATE_LIMIT_PER_MIN=10
TRUSTLENS_DAILY_CAP=500
TRUSTLENS_MAX_TEXT_CHARS=8000
TRUSTLENS_MAX_IMAGE_BYTES=4194304
# Number of trusted reverse proxies in front of the server (X-Forwarded-For handling). 0 = ignore the header.
TRUSTLENS_PROXY_HOPS=1
# Comma-separated browser origins allowed to call the API (the Next.js frontend).
TRUSTLENS_CORS_ORIGINS=http://localhost:3000
PORT=8080
LOG_LEVEL=info

# Accounts (optional). Set a long random AUTH_SECRET in production (e.g. `openssl rand -hex 32`).
AUTH_SECRET=
AUTH_DATA_FILE=data/users.json
SESSION_TTL_DAYS=7
TRUSTLENS_USER_RATE_LIMIT_PER_MIN=30
